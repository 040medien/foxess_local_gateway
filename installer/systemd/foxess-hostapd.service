[Unit]
Description=FoxESS inverter Wi-Fi hostapd
Documentation=file:/opt/foxess-local-cloud/LOCAL_CLOUD_PI.md
After=foxess-pi-ap.service foxess-local-cloud.service
Requires=foxess-pi-ap.service foxess-local-cloud.service
PartOf=foxess-pi-ap.service

[Service]
Type=simple
ExecStart=/usr/sbin/hostapd /etc/hostapd/hostapd-foxess.conf
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
